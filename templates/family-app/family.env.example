# Template for /etc/family.env on the server. Copy it there, fill it in, then: sudo chmod 640 /etc/family.env
# One NAME=value per line, no spaces around =, comments on their own lines only.
# Read by: docker compose --env-file /etc/family.env up -d --build

# The site's address, as readers will type it.
BASE_URL=https://family.example.com

# Where deploy.sh puts site/, private/ and app/ on the server (deploy.remote_dir in site-src/site.json, as an absolute path).
FAMILY_HOST_DIR=/home/USER/family

# The admin: can sign in from the start, sees everyone, gets the access-request emails.
ADMIN_EMAIL=you@example.com
# Optional: the admin's person in the tree (ID without @) and name; default: the root person and owner_name from the build.
ADMIN_PERSON=
OWNER_NAME=

# console writes emails to the container log (docker logs family-api); ses sends them through Amazon SES.
EMAIL_BACKEND=console
MAIL_FROM=Our Family History <family@example.com>
SES_REGION=us-east-1

# Access key of an IAM user that may only send as MAIL_FROM (aws/ses-send-policy.json). Empty while EMAIL_BACKEND=console.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
